<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/pickFileButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/open_local_file" />

        <Button
            android:id="@+id/localStartDubButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start_dub" />

        <Button
            android:id="@+id/localStopDubButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stop_dub" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/localMicDubButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_dub_mic" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextureView
            android:id="@+id/textureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/delayedFrameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/localWaitView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#ED000000"
            android:gravity="center"
            android:text="Đang chuẩn bị lồng tiếng…"
            android:textColor="@color/dub_white"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/localSubtitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/dub_black"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/dub_white"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/localHudView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@color/dub_black"
            android:padding="6dp"
            android:textColor="@color/dub_accent"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
